PORT=5000
# Optional: Set your MongoDB Atlas connection string below to use cloud database.
# If omitted or unavailable, Alterjot automatically runs seamlessly in Hybrid Local Store mode!
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/alterjot?retryWrites=true&w=majority

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


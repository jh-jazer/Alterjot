PORT=5000
# Optional: Set your MongoDB Atlas connection string below to use cloud database.
# If omitted or unavailable, Alterjot automatically runs seamlessly in Hybrid Local Store mode!
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/alterjot?retryWrites=true&w=majority

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Groq API Key (from https://console.groq.com/keys) - Ultra-fast Meta Llama 3.3 70B
GROQ_API_KEY=

# Optional: OpenRouter API Key (from https://openrouter.ai/keys) - Free open models
OPENROUTER_API_KEY=
